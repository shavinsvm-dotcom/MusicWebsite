{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nocturne",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // 1. npx wrangler r2 bucket create nocturne-audio
  // 2. npx wrangler d1 create nocturne-db   → paste the database_id below
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "nocturne-audio" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nocturne-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
