{
  "name": "nocturne",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "check:worker": "tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite preview",
    "audio": "node scripts/gen-audio.mjs",
    "api": "npx --yes wrangler dev --config wrangler.dev.jsonc --port 8787"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "4.148.0"
  }
}
