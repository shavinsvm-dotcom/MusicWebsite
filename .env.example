# Optional: stream uploads from Supabase Storage (free plan, no credit card).
# Leave these empty to use the built-in browser vault.
#
# 1. Create a project at https://supabase.com (email or GitHub sign-in).
# 2. Storage → New bucket → name "tracks", toggle Public on.
# 3. Run the two policies from README → "Supabase Storage".
# 4. Project settings → API → copy the Project URL and the publishable (anon) key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=tracks
