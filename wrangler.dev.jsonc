{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nocturne-api-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Local API only: no R2/D1 bindings, so nothing needs a Cloudflare account.
  // Secrets come from .dev.vars; these are non-secret defaults you can override.
  "vars": {
    "TIGRIS_BUCKET": "nocturne-audio",
    "TIGRIS_ENDPOINT": "https://t3.storage.dev",
    "TIGRIS_REGION": "auto"
  }
}
