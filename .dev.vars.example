# Local-only Worker secrets. Copy to .dev.vars (git-ignored) and fill in yourself.
# Never commit real keys and never paste them into a chat.
#
# For Tigris: console.storage.dev → Access keys → create an access key.
# The bucket must already exist (Tigris creates one during onboarding).

TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_BUCKET=
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_REGION=auto
